NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/utsavx
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters. Required in production to be unique/non-default.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Free tickets without Stripe. Auto-enabled in development when Stripe is unset.
# In production set explicitly, or configure Stripe instead.
ALLOW_DEMO_PAYMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
