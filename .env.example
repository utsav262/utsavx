NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/utsavx
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters. Required in production to be unique/non-default.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Admin console tokens — must differ from JWT_SECRET (min 32 chars)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret
ADMIN_JWT_EXPIRES_IN=8h
# Free tickets without a payment gateway. Auto-enabled in development when Razorpay/Stripe are unset.
# In production set explicitly, or configure Razorpay instead.
ALLOW_DEMO_PAYMENTS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Settlements: platform bank account hosts transfer cash/gate-sale fees into (shown on /dashboard/settlements)
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_IFSC=
PLATFORM_BANK_UPI=
# Where settlement receipts are stored (private; defaults to server/storage/receipts)
RECEIPT_STORAGE_DIR=

# One-time: creates the first super_admin on boot if none exists. Remove after first sign-in.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=
