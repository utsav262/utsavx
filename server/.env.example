NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/utsavx
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters. Required in production to be unique/non-default.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Free tickets without a gateway. Auto-enabled in development when Razorpay/Stripe are unset.
ALLOW_DEMO_PAYMENTS=
# Razorpay (preferred for INR). Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Stripe fallback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
