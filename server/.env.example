NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173
# Optional extra frontends (comma-separated), e.g. Vercel production + preview
# CLIENT_URLS=https://utsavx.vercel.app,https://utsavx-git-main-xxx.vercel.app
MONGO_URI=mongodb://127.0.0.1:27017/utsavx
REDIS_URL=redis://127.0.0.1:6379
# Unpaid checkout holds inventory for this many minutes (then auto-releases).
HOLD_TTL_MINUTES=15
# Public browse cache TTLs in seconds (requires Redis).
CACHE_LIST_TTL_SECONDS=30
CACHE_DETAIL_TTL_SECONDS=15
CACHE_CATALOG_TTL_SECONDS=300
# At least 32 random characters. Required in production to be unique/non-default.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Admin console tokens — must differ from JWT_SECRET (min 32 chars)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret
ADMIN_JWT_EXPIRES_IN=8h
# Free tickets without a gateway. Auto-enabled in development when Razorpay/Stripe are unset.
ALLOW_DEMO_PAYMENTS=
# Razorpay (preferred for INR). Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Stripe fallback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Settlements: platform bank account hosts transfer cash/gate-sale fees into (shown on /dashboard/settlements)
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_IFSC=
PLATFORM_BANK_UPI=
# Where settlement receipts are stored (private; defaults to server/storage/receipts)
RECEIPT_STORAGE_DIR=
